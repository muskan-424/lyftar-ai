# Copy to .env and fill in. Real keys never go in the repo.

# --- Backend ---
# Comma-separated Gemini API key pool (at least 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-gemini-key-1,your-gemini-key-2
# LiteLLM model name.
LLM_MODEL=gemini/gemini-3.5-flash
# SQLite location. In Docker this sits on the named volume mounted at /data.
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins (your deployed frontend URL in production).
ALLOWED_ORIGINS=http://localhost:3000
# true enables the X-Simulate-Failure test header. Must be true on the deployed backend.
ENABLE_FAILURE_SIMULATION=true

# Optional
CACHE_ENABLED=true
CACHE_TYPE=local                # local (in-memory) or disk
CACHE_DIR=/data/llm_cache       # used when CACHE_TYPE=disk
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.
LLM_TIMEOUT_SECONDS=30
# Empty = model default; or one of: low | medium | high | disable. Keep the value empty or a bare word:
# an inline '# comment' after an empty value is read as the value by Docker Compose.
LLM_REASONING_EFFORT=
MOCK_LLM=false                  # true = fake provider replies (no keys needed); for tests/demos only

# --- Frontend (build-time) ---
VITE_API_BASE_URL=http://localhost:8000
